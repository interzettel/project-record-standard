{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-record:0.2.0",
  "title": "Shared project record 0.2.0",
  "description": "Structural interoperability with 0.1 read compatibility. Run the semantic validator for references, cycles, unique ownership, approvals and denominator rules.",
  "type": "object",
  "required": [
    "contractVersion",
    "project",
    "source",
    "items",
    "groups",
    "milestones"
  ],
  "properties": {
    "contractVersion": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "repository",
        "visibility"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "commit",
        "observedOn",
        "sha256",
        "authority"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "kind": {
          "enum": [
            "git-snapshot",
            "file-snapshot"
          ]
        },
        "observedOn": {
          "type": "string",
          "format": "date"
        },
        "updatedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "commit": {
                "type": "null"
              }
            }
          },
          "then": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "file-snapshot"
              }
            }
          }
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "groupId",
          "milestoneId",
          "state",
          "sourceState",
          "required",
          "blocked",
          "dependsOn",
          "unmappedDependencies",
          "completionBasis",
          "kind",
          "owner",
          "priority",
          "issueUrl",
          "criterion",
          "note",
          "deferReason",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "groupId": {
            "type": "string",
            "minLength": 1
          },
          "milestoneId": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "backlog",
              "ready",
              "active",
              "review",
              "done",
              "cancelled",
              "unknown"
            ]
          },
          "sourceState": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "blocked": {
            "type": "boolean"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "unmappedDependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "completionBasis": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": [
              "string",
              "null"
            ]
          },
          "issueUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "criterion": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "deferReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "source"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "panel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "panel": {
            "type": "string",
            "minLength": 1
          },
          "progress": {
            "type": "object",
            "required": [
              "done",
              "total",
              "percent"
            ],
            "properties": {
              "done": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "percent": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              }
            },
            "additionalProperties": true
          },
          "ledgerProgress": {
            "type": "object",
            "required": [
              "done",
              "total",
              "percent"
            ],
            "properties": {
              "done": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "percent": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "goal",
          "horizon",
          "groupIds",
          "gateItemIds",
          "acceptanceRule",
          "sourceAccepted",
          "unscopedWork"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "horizon": {
            "enum": [
              "Now",
              "Next",
              "Later"
            ]
          },
          "groupIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "gateItemIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "acceptanceRule": {
            "enum": [
              "source-state",
              "all-gate-items",
              "unknown"
            ]
          },
          "sourceAccepted": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "accepted": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "unscopedWork": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "nextAction": {
            "type": [
              "string",
              "null"
            ]
          },
          "progress": {
            "type": "object",
            "required": [
              "done",
              "total",
              "percent"
            ],
            "properties": {
              "done": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "percent": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "presentation": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "history": {
      "type": "object",
      "required": [
        "snapshots",
        "comparisons",
        "coverage"
      ]
    },
    "deliverySummary": {
      "type": "object"
    },
    "deliveryCoverage": {
      "type": "string",
      "minLength": 1
    },
    "inputVisibility": {
      "type": "array",
      "items": {
        "enum": [
          "public",
          "private"
        ]
      }
    },
    "supplementSources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "purpose",
        "owner",
        "acceptanceAuthority",
        "changeAuthority",
        "approach",
        "tailoring"
      ],
      "properties": {
        "approach": {
          "enum": [
            "adaptive",
            "predictive",
            "hybrid"
          ]
        },
        "tailoring": {
          "type": "object",
          "required": [
            "governance",
            "scope",
            "schedule",
            "finance",
            "stakeholders",
            "resources",
            "risk"
          ]
        },
        "workPackages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "deliverable",
              "owner",
              "acceptance",
              "workItemIds"
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "component",
          "type",
          "summary"
        ]
      }
    },
    "releasePlans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "component",
          "channel",
          "gates"
        ]
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component",
          "channel",
          "version",
          "url",
          "publishedAt",
          "observedAt"
        ]
      }
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "environment",
          "observedAt"
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "source"
        ]
      }
    }
  },
  "additionalProperties": false
}
